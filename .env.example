# Copy to .env. Already gitignored.
#
# crux needs a model that supports FORCED TOOL CALLING. Every structured answer
# goes through one, so a provider without it cannot run crux at all.

# --- one key per provider you use, under that provider's own name ---
ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIzaSy...
# COHERE_API_KEY=...

# --- which model does what ---
CRUX_MODEL=claude-sonnet-5
# The cheap tier: phrasing, classifying, counter-answers, drafting.
# Defaults to CRUX_MODEL, so one line is a complete configuration.
# CRUX_WEAK_MODEL=groq/openai/gpt-oss-20b

# --- tried in order when a model is rate limited, down, or refuses ---
# CRUX_FALLBACK_MODELS=gemini/gemini-3.6-flash,cohere_chat/command-a-03-2025

# --- an OpenAI-compatible endpoint litellm has no native route for ---
# Global, so both are ignored once a fallback chain is set.
# CRUX_API_KEY=...
# CRUX_API_BASE=https://integrate.api.nvidia.com/v1

# --- limits ---
# CRUX_MAX_TOKENS=8192
# CRUX_MAX_PASSES=3
# CRUX_MAX_QUESTIONS_TOTAL=6
